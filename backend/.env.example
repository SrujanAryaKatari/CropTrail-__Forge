# Copy to .env and fill in. Empty keys = fallback/cached mode for that integration.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
DATA_GOV_IN_API_KEY=
MANDI_RESOURCE_ID=
GEE_SERVICE_ACCOUNT_JSON=
FIRMS_MAP_KEY=
DATABASE_PATH=./croptrail.db
UPLOAD_DIR=./uploads
FRONTEND_ORIGIN=http://localhost:3000
MONITOR_INTERVAL_HOURS=6
HEAVY_RAIN_MM=64.5
REPORT_WINDOW_HOURS=72
SPRAY_RAIN_LOOKAHEAD_HOURS=24
DEMO_EVENT_DATE=2026-10-14
USE_CACHED_DATA=false
ALLOW_SIMULATION=true
TIMEZONE=Asia/Kolkata
# Optional: pin the clock for demo rehearsals, e.g. 2026-10-30T10:00:00+05:30
CROPTRAIL_NOW=
